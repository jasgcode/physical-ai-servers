# Copy to .env and fill in real keys — or generate automatically:
#   bash scripts/gen_keys.sh > .env && chmod 600 .env
# Values here are read by the server (pydantic) but NOT exported to the process
# environment; HF_HOME is exported by the pixi activation env and launch.sh.

# Separate multiple keys with commas
GROOT_API_KEYS=sk-GROOT-replace-me

# One action chunk (40 steps on the base model) per call
GROOT_RATE_LIMIT=600/minute

# HF id or local checkpoint dir, and the embodiment it is served for
# GROOT_MODEL_ID=nvidia/GR00T-N1.7-3B
# GROOT_EMBODIMENT_TAG=OXE_DROID_RELATIVE_EEF_RELATIVE_JOINT

# GROOT_PORT=8000
# GROOT_DEVICE=cuda:0
