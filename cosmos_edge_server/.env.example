# Copy to .env and fill in real keys — or generate automatically:
#   bash scripts/gen_keys.sh > .env && chmod 600 .env
# Values here are read by the server (pydantic) but NOT exported to the process
# environment; HF_HOME is exported by the pixi activation env and launch.sh.

# Separate multiple keys with commas
COSMOS_EDGE_API_KEYS=sk-COSMOS_EDGE-replace-me

# One 32-step chunk takes about a second; a client re-plans ~1x/s
COSMOS_EDGE_RATE_LIMIT=120/minute

# COSMOS_EDGE_MODEL_ID=nvidia/Cosmos3-Edge-Policy-DROID
# Denoising steps: the main latency lever (upstream default 4)
# COSMOS_EDGE_NUM_STEPS=4
# COSMOS_EDGE_DETERMINISTIC_SEED=false

# COSMOS_EDGE_PORT=8000
# The GPU is chosen with CUDA_VISIBLE_DEVICES; upstream has no device argument.
