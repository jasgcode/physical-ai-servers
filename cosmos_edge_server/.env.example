# Copy to .env and fill in real keys — or generate automatically:
#   bash scripts/gen_keys.sh > .env && chmod 600 .env
# Values here are read by the server (pydantic) but NOT exported to the process
# environment; HF_HOME is exported by the pixi activation env and launch.sh.

# Separate multiple keys with commas
COSMOS_EDGE_API_KEYS=sk-COSMOS_EDGE-replace-me

# One 32-step chunk takes ~0.4 s on a 5090; a client re-plans up to ~2.5x/s
COSMOS_EDGE_RATE_LIMIT=300/minute

# COSMOS_EDGE_MODEL_ID=nvidia/Cosmos3-Edge-Policy-DROID
# COSMOS_EDGE_DETERMINISTIC_SEED=false

# ---- latency (docs/run.md has the measured table) ----
# Defaults: same model output as upstream's Edge recipe, just faster.
# COSMOS_EDGE_GUIDANCE_INTERVAL=960,1001   # empty = guide every step (+60% time)
# COSMOS_EDGE_GPU_PREPROCESS=true
# COSMOS_EDGE_USE_TORCH_COMPILE=true
#
# Opt-in: these change what the model computes. Faster, but task success is
# NOT validated here — run the RoboLab eval before trusting them on a robot.
# COSMOS_EDGE_NUM_STEPS=4                  # 3 -> ~-35 ms
# COSMOS_EDGE_GUIDANCE=3.0                 # 1.0 = no guidance forward at all
# COSMOS_EDGE_RESOLUTION=480               # 256 needs the two lines below
# COSMOS_EDGE_IMAGE_HEIGHT=540             # 270 at resolution 256
# COSMOS_EDGE_IMAGE_WIDTH=640              # 320 at resolution 256
# COSMOS_EDGE_ACTION_CHUNK_SIZE=32         # 16 halves the horizon and the rollout

# COSMOS_EDGE_PORT=8000
# The GPU is chosen with CUDA_VISIBLE_DEVICES; upstream has no device argument.
