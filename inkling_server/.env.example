# Copy to .env and fill in real keys — or generate automatically:
#   bash scripts/gen_keys.sh > .env && chmod 600 .env
# Values here are read by the server (pydantic) but NOT exported to the process
# environment.

# Separate multiple keys with commas
INKLING_API_KEYS=sk-INKLING-replace-me
INKLING_RATE_LIMIT=120/minute

# Hub id (downloaded into weights/.cache) or an existing local snapshot dir,
# e.g. .../hub/models--thinkingmachines--Inkling-2-Mini/snapshots/<revision>
# INKLING_MODEL=thinkingmachines/Inkling-2-Mini

# ---- engine ----
# INKLING_MAX_MODEL_LEN=65536        # ~95K is the most a 32 GB card fits
# INKLING_MAX_NUM_SEQS=8
# INKLING_SPECULATIVE_TOKENS=7       # 0 turns DSpark speculative decoding off
# INKLING_GPU_MEMORY_UTILIZATION=    # empty = vLLM default
# INKLING_ENGINE_EXTRA_ARGS=         # appended to `vllm serve`
# INKLING_ENGINE_PORT=8100           # private, 127.0.0.1 only
# INKLING_PORT=8000
